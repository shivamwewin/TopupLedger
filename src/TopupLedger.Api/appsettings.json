{
  "LedgerRules": {
    "Variant": "V1"
  },
  "ConnectionStrings": {
    "TopupLedger": ""
  },
  "DataProtection": {
    "KeyBase64": ""
  },
  "Operators": {
    "EtisalatToken": "",
    "DuToken": ""
  },
  "RateLimit": {
    "PermitsPerSecond": 20,
    "Burst": 40
  },
  "Topup": {
    "ExpirySeconds": 120,
    "IdempotencyLeaseSeconds": 30,
    "IdempotencyTtlHours": 24
  },
  "Seed": {
    "OnStartup": true
  },
  "Workers": {
    "Expiry": true,
    "Settlement": true
  },
  "OperatorSimulator": {
    "Enabled": true,
    "CallbackBaseUrl": "http://127.0.0.1:8080",
    "MinDelaySeconds": 1,
    "MaxDelaySeconds": 15,
    "SuccessPercent": 85,
    "FailedPercent": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
