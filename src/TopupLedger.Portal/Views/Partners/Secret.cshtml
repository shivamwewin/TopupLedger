@{
    ViewData["Title"] = "API secret";
}
<h1 class="h3">Secret for @ViewBag.Name</h1>
<div class="alert alert-warning">This secret is shown once. It is stored only as ciphertext.</div>
<p>API key: <code>@ViewBag.ApiKey</code></p>
<p>Secret: <code>@ViewBag.Secret</code></p>
<a asp-action="Index">Back to partners</a>
